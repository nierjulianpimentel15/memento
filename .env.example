# Database
# Use the Supabase "Transaction" pooler connection string (port 6543) here —
# this is what your deployed app (Vercel serverless functions) should use.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres:your_password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres:your_password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Auth
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Storage backend: "local" | "supabase" | "cloudinary"
STORAGE_DRIVER="supabase"

# Supabase (Project Settings -> API)
SUPABASE_URL="https://frylrpdrthqvngogqfdf.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
SUPABASE_BUCKET="memento-images"

# Cloudinary (only needed if STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Redis (optional, for caching / rate limiting)
REDIS_URL="redis://localhost:6379"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
